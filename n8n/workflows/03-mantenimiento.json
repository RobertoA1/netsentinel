          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "19288b63-ede7-58f2-a304-efcc61dcceed",
      "name": "Diario 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
