      "id": "66dc2d89-3ab1-5180-a49d-167d14fe7ecd",
      "name": "GET /health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Registra el resultado del mantenimiento diario (queda en la ejecucion y en los logs de n8n).\nconst purga = $('POST /maintenance/purge').first().json || {};\nconst salud = $('GET /health').first().json || {};\nconst purgaOk = !purga.error;\nconst saludOk = salud.status === 'ok' && salud.db !== false;\nconst resumen = {\n  fecha: new Date().toISOString(),\n  purga_ok: purgaOk, purga: purgaOk ? purga : (purga.error.message || String(purga.error)),\n  salud_ok: saludOk, health: salud.error ? (salud.error.message || String(salud.error)) : salud,\n};\nconsole.log('Mantenimiento NetSentinel: ' + JSON.stringify(resumen));\nif (!purgaOk || !saludOk) {\n  // Hace fallar la ejecucion para que quede visible en n8n (Executions) y pueda alertarse.\n  throw new Error('Mantenimiento con problemas: ' + JSON.stringify(resumen));\n}\nreturn [{ json: resumen }];\n"
      },
      "id": "73766114-89ac-526b-b4b6-6f16de440e8d",
      "name": "Registrar resultado",
