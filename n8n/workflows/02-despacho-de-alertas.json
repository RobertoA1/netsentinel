            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1e87bf8a-6157-5fa6-9eba-d2fe5a9ce51c",
              "leftValue": "={{ $env.NETSENTINEL_SMTP_ENABLED }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1305be03-eafb-51f0-87c6-cd244cdd79f4",
      "name": "¿SMTP habilitado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "netsentinel@example.com",
        "toEmail": "={{ $('Resolver destino').item.json.email_to }}",
        "subject": "=[NetSentinel] {{ $('Resolver destino').item.json.severity }}: {{ $('Resolver destino').item.json.title }}",
        "emailFormat": "text",
        "text": "={{ $('Resolver destino').item.json.message }}",
        "options": {}
      },
      "id": "f7b43b42-b36a-50a7-bd7c-95ad7d79f845",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
