# =============================================================================
# NetSentinel - variables de entorno
# Copie este archivo a .env o, mejor, ejecute `make init` (scripts/init-env.sh),
# que genera .env con secretos aleatorios. NUNCA suba .env al repositorio.
# Los valores "CAMBIAR" los reemplaza init-env.sh.
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=netsentinel
POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=CAMBIAR
# Cadena de conexión del backend (host interno `db`, puerto 5432). Debe usar la misma contraseña.
DATABASE_URL=postgresql://netsentinel:CAMBIAR@db:5432/netsentinel

# --- Seguridad del backend --------------------------------------------------
# Firma de los JWT (access 30 min / refresh 7 días).
JWT_SECRET=CAMBIAR
# Clave de máquina: n8n la envía en la cabecera X-API-Key al backend.
N8N_API_KEY=CAMBIAR

# --- Usuario administrador inicial (lo crea la semilla del backend) ---------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR
ADMIN_EMAIL=admin@netsentinel.local

# --- LLM local (Ollama) -----------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# llama3.2:3b pesa ~2 GB. Cambie por otro modelo de Ollama si dispone de más RAM/GPU.
OLLAMA_MODEL=llama3.2:3b

# --- Rutas dentro del contenedor del backend (montadas desde ./data) --------
INGEST_DIR=/data/ingest
DATASET_DIR=/data/dataset
REPORTS_DIR=/data/reports

# --- CORS: orígenes permitidos (separados por comas) ------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- n8n --------------------------------------------------------------------
# Cifra las credenciales guardadas en n8n. No la cambie después del primer arranque.
N8N_ENCRYPTION_KEY=CAMBIAR
# Zona horaria de los cron de n8n.
GENERIC_TIMEZONE=America/Lima
# El nodo Send Email del flujo 02 está deshabilitado. Ponga "true" SOLO después de
# crear la credencial SMTP y habilitar el nodo (si no, las alertas por correo quedan pendientes).
NETSENTINEL_SMTP_ENABLED=false
